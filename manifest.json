{
  "manifest_version": 3,
  "name": "کامیار | یار هوشمند شما",
  "short_name": "Kamyar",
  "version": "2.9.0",
  "description": "Kamyar, your smart companion: calendar, tasks, notes and shortcuts in your new tab, saved in your own Google account. No ads, no tracking.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": "icons/icon-32.png",
    "default_title": "Kamyar"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "permissions": [
    "storage",
    "identity",
    "identity.email",
    "favicon",
    "alarms",
    "notifications",
    "contextMenus",
    "declarativeNetRequest",
    "offscreen",
    "scripting",
    "activeTab"
  ],
  "optional_permissions": ["bookmarks", "topSites"],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://query1.finance.yahoo.com/*",
    "https://query2.finance.yahoo.com/*",
    "https://api.audd.io/*"
  ],
  "oauth2": {
    "client_id": "PASTE_YOUR_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.appdata"
    ]
  },
  "key": "",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://www.googleapis.com https://oauth2.googleapis.com https://api.open-meteo.com https://geocoding-api.open-meteo.com https://api.frankfurter.app https://open.er-api.com https://api.coingecko.com https://api.navasan.tech https://query1.finance.yahoo.com https://query2.finance.yahoo.com https://api.audd.io"
  }
}